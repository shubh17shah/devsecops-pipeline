# syntax=docker/dockerfile:1
#
# INTENTIONALLY VULNERABLE — do not use this image anywhere real.
#
# This file exists for exactly one reason: to give
# .github/workflows/verify-security-gates.yml something that the Trivy
# gate in .github/workflows/ci.yml is guaranteed to block, so that gate's
# behavior is checked on a schedule instead of trusted on faith. It is not
# an alternate build target, it is not used by `docker build` in ci.yml,
# and it is never pushed to a registry.
#
# The regression from app/Dockerfile is narrow and deliberate: same
# application code, same npm install, but the runtime stage sits on
# `node:16-alpine` instead of `node:20-alpine`. Node.js 16 reached
# End-of-Life in September 2023 — no further security patches are
# published for it or the Alpine package set pinned alongside it, so
# Trivy's vulnerability database has an accumulating, permanent supply of
# HIGH/CRITICAL CVEs against it (openssl, libcrypto, zlib, plus whatever
# npm-installed native addons link against them). That is what makes it
# useful as a control-verification fixture: it doesn't stop being
# vulnerable, so the gate has something durable to keep catching.
#
# See docs/SECURITY-GATES.md for what this proves and how the workflow
# reads.

# ---- deps stage (unchanged from app/Dockerfile) ---------------------------
FROM node:16-alpine AS deps
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev && npm cache clean --force

# ---- runtime stage: deliberately EOL, deliberately root -------------------
# node:16-alpine ("Node 16") is EOL — nothing in its package set has been
# patched since. No USER instruction either: this runs as root, on purpose,
# so it also flags on a misconfiguration check, not just CVE count.
FROM node:16-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src

EXPOSE 8080
CMD ["node", "src/server.js"]
